# PRESENZE GAMA — impostazioni del server
# Copia questo file in ".env" e cambia i valori.

# L'indirizzo con cui i telefoni raggiungono il server. Deve essere https:
# senza https i telefoni non installano l'app e non mostrano le notifiche.
# Per una prova sul tuo PC va bene http://localhost:3000
URL_PUBBLICO=https://presenze.tuodominio.it

# Porta su cui ascolta l'app (dietro Caddy o al tunnel)
PORTA=3000

# Dove stanno database e backup
CARTELLA_DATI=./dati

# Fuso orario: lasciare cosi'
TZ=Europe/Rome

# FACOLTATIVO: il token del bot Telegram di oggi. Se c'e', i promemoria arrivano
# anche su Telegram a chi ha il codice Telegram (importato dal Foglio Google).
TELEGRAM_TOKEN=
